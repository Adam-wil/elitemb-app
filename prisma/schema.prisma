generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  profiles  Profile[]
}

model Profile {
  id                   String                @id @default(uuid())
  userId               String
  name                 String
  isDefault            Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  bookieNotes          BookieNote[]
  bookieRatioConfigs   BookieRatioConfig[]
  bonuses              Bonus[]
  commissionPreference CommissionPreference?
  layManagerEntries    LayManagerEntry[]
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  planEntries          RacingPlanEntry[]
  trackerEntries       RacingTrackerEntry[]
  accountLedgerEntries AccountLedger[]
  accountBalances      AccountBalance[]

  @@index([userId])
}

/// 134 Australian/NZ bookies with all metadata
model Bookie {
  id                  Int                 @id @default(autoincrement())
  name                String              @unique
  normalizedName      String              @unique
  signUpOffers        String?
  linkedBookies       String?
  accountSetupNotes   String?
  promoVolume         PromoVolume?
  banRisk             RiskLevel?
  defenceNotes        String?
  horseSystem         String?
  sportSystem         String?
  femaleAccounts      String?
  statDecRisk         RiskLevel?
  learnBetfairFirst   String?
  oddsRating          String?
  minimumRunners      String?
  website             String?
  bookieSoftware      String?
  stateOfRegistration String?
  isExchange          Boolean             @default(false)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  bookieNotes         BookieNote[]
  ratioConfigs        BookieRatioConfig[]
  ledgerEntries       AccountLedger[]
  accountBalances     AccountBalance[]
}

/// State commission rates for Betfair based on track location
model StateCommissionRate {
  code        String   @id
  name        String
  defaultRate Decimal  @db.Decimal(5, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tracks      Track[]
}

/// 150+ Australian/NZ tracks with state mapping
model Track {
  id        Int                 @id @default(autoincrement())
  name      String              @unique
  stateCode String
  country   String              @default("AU")
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  state     StateCommissionRate @relation(fields: [stateCode], references: [code])

  @@index([stateCode])
}

model RacingPlanEntry {
  id                     String               @id @default(uuid())
  profileId              String
  date                   DateTime             @db.Date
  track                  String
  raceNumber             Int
  time                   String
  skip                   Boolean              @default(false)
  unitTier               UnitTier             @default(NEUTRAL)
  timeValidationStatus   TimeValidationStatus @default(PENDING)
  apiTime                String?
  timeDifferenceMinutes  Int?
  normalPromosByBookie   Json                 @default("{}")
  betBackPromosByBookie  Json                 @default("{}")
  selectedNormalBookies  String[]             @default([])
  selectedBetBackBookies String[]             @default([])
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  profile                Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  trackerEntries         RacingTrackerEntry[]

  @@unique([profileId, date, track, raceNumber])
  @@index([profileId, date])
  @@index([date])
}

model RacingTrackerEntry {
  id                     String           @id @default(uuid())
  profileId              String
  planEntryId            String?
  date                   DateTime         @db.Date
  time                   String
  track                  String
  raceNumber             Int
  meetingId              Int?
  selectionName          String
  selectionNumber        Int
  selectedNormalBookies  String[]         @default([])
  selectedBetBackBookies String[]         @default([])
  promoDetails           Json             @default("{}")
  backBookie             String
  backStake              Decimal          @db.Decimal(10, 2)
  backOdds               Decimal          @db.Decimal(8, 3)
  backCommissionPercent  Decimal?         @db.Decimal(5, 2)
  layBookie              String?          @default("Betfair")
  layStake               Decimal?         @db.Decimal(10, 2)
  layOdds                Decimal?         @db.Decimal(8, 3)
  layCommissionPercent   Decimal?         @db.Decimal(5, 2)
  unitTier               UnitTier         @default(NEUTRAL)
  promoType              String?          // PromoType for bonus determination (none, 2nd_bonus, 2nd_3rd_bonus, bet_back)
  autoResult             Json?
  lastPolledAt           DateTime?
  pollAttempts           Int              @default(0)
  outcome                RaceOutcome      @default(PENDING)
  outcomeNotes           String?
  profitLoss             Decimal?         @db.Decimal(10, 2)
  lockedInAt             DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  readOnly               Boolean          @default(false)
  linkedBonusId          String?          @unique // Bonus being used/turned over in this race
  generatedBonusId       String?          // Bonus generated from this race (when outcome = Bonus)
  planEntry              RacingPlanEntry? @relation(fields: [planEntryId], references: [id])
  profile                Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  linkedBonus            Bonus?           @relation("UsedBonus", fields: [linkedBonusId], references: [id])
  generatedBonus         Bonus?           @relation("GeneratedBonus")

  @@index([profileId, date])
  @@index([date])
  @@index([outcome])
  @@index([backBookie])
  @@index([linkedBonusId])
}

model LayManagerEntry {
  id                     String      @id @default(uuid())
  profileId              String
  date                   DateTime    @db.Date
  time                   String
  track                  String
  raceNumber             Int
  meetingId              Int?
  selectionName          String
  selectionNumber        Int
  selectedNormalBookies  String[]    @default([])
  selectedBetBackBookies String[]    @default([])
  promoDetails           Json        @default("{}")
  backBookie             String
  backStake              Decimal     @db.Decimal(10, 2)
  backOdds               Decimal     @db.Decimal(8, 3)
  backCommissionPercent  Decimal?    @db.Decimal(5, 2)
  layBookie              String      @default("Betfair")
  layStake               Decimal     @db.Decimal(10, 2)
  layOdds                Decimal     @db.Decimal(8, 3)
  layCommissionPercent   Decimal?    @db.Decimal(5, 2)
  unitTier               UnitTier    @default(NEUTRAL)
  autoResult             Json?
  lastPolledAt           DateTime?
  pollAttempts           Int         @default(0)
  outcome                RaceOutcome @default(PENDING)
  outcomeNotes           String?
  profitLoss             Decimal?    @db.Decimal(10, 2)
  lockedInAt             DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  readOnly               Boolean     @default(false)
  linkedBonusId          String?     @unique // Bonus being used/turned over in this race
  profile                Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  linkedBonus            Bonus?      @relation("UsedBonus", fields: [linkedBonusId], references: [id])
  generatedBonus         Bonus?      @relation("GeneratedBonus")

  @@index([profileId, date])
  @@index([date])
  @@index([outcome])
  @@index([backBookie])
  @@index([layBookie])
  @@index([linkedBonusId])
}

model BookieNote {
  id        String   @id @default(uuid())
  profileId String
  bookieId  Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bookie    Bookie   @relation(fields: [bookieId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, bookieId])
  @@index([profileId])
  @@index([bookieId])
}

model CommissionPreference {
  id          String   @id @default(uuid())
  profileId   String   @unique
  defaultRate Decimal  @default(5) @db.Decimal(5, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

enum UnitTier {
  GREEN
  NEUTRAL
  PINK
}

enum TimeValidationStatus {
  PENDING
  VERIFIED
  MISMATCH
  NOT_FOUND
}

enum RaceOutcome {
  WIN
  LOSS
  BONUS
  DEAD_HEAT
  MIDDLE
  REFUND
  PENDING
  SCRATCHED
}

enum PromoVolume {
  HIGH
  MEDIUM
  LOW
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum RatioTimeWindow {
  DAILY
  WEEKLY
  MONTHLY
}

enum BookieAccountStatus {
  PROMO_ELIGIBLE
  GUBBED
  STAT_DECD
  SUSPENDED
  CLOSED
}

enum BonusStatus {
  PENDING
  TURNED_OVER
  EXPIRED
  CANCELLED
}

/// The Stable - Bonus Holding Pen
/// Tracks bonus bets earned from promos until they are turned over
model Bonus {
  id                       String                @id @default(uuid())
  profileId                String
  bookie                   String
  amount                   Decimal               @db.Decimal(10, 2)
  dateEarned               DateTime              @db.Date
  expiryDate               DateTime              @db.Date
  status                   BonusStatus           @default(PENDING)
  turnedOverAt             DateTime?
  bonusTurnoverProfit      Decimal?              @db.Decimal(10, 2) // Net bonus profit after Betfair commission and losses
  sourceRacingEntryId      String?               @unique
  sourceLayManagerEntryId  String?               @unique
  sourcePromoType          String?
  notes                    String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  profile                  Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sourceRacingEntry        RacingTrackerEntry?   @relation("GeneratedBonus", fields: [sourceRacingEntryId], references: [id])
  sourceLayManagerEntry    LayManagerEntry?      @relation("GeneratedBonus", fields: [sourceLayManagerEntryId], references: [id])
  usedByRacingEntry        RacingTrackerEntry?   @relation("UsedBonus")
  usedByLayManagerEntry    LayManagerEntry?      @relation("UsedBonus")

  @@index([profileId])
  @@index([profileId, status])
  @@index([bookie])
  @@index([expiryDate])
  @@index([status])
}

/// Bookie Health - Promo ratio configuration per bookie
/// Tracks target promo:non-promo ratios to help avoid being gubbed
model BookieRatioConfig {
  id                String              @id @default(uuid())
  profileId         String
  bookieId          Int
  promoRatio        Int                 @default(1)
  nonPromoRatio     Int                 @default(3)
  timeWindow        RatioTimeWindow     @default(WEEKLY)
  status            BookieAccountStatus @default(PROMO_ELIGIBLE)
  statusNotes       String?
  statusChangedAt   DateTime?
  warningThreshold  Int                 @default(80)
  exceededThreshold Int                 @default(100)
  isEnabled         Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  profile           Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bookie            Bookie              @relation(fields: [bookieId], references: [id], onDelete: Cascade)

  @@unique([profileId, bookieId])
  @@index([profileId])
  @@index([status])
}

// ============================================================================
// Account Ledger - Financial tracking for bookie/exchange accounts
// ============================================================================

enum LedgerEntryType {
  DEPOSIT         // Money sent TO bookie/exchange
  WITHDRAWAL      // Money received FROM bookie/exchange
  BET_WIN         // Winning bet P&L (from tracker)
  BET_LOSS        // Losing bet P&L (from tracker)
  BONUS_CREDIT    // Bonus received
  BONUS_TURNOVER  // Bonus wagering result
  ADJUSTMENT      // Manual balance adjustment
  COMMISSION      // Exchange commission
  REFUND          // Bet refund
}

/// Account Ledger Entry - Individual transaction in the ledger
/// Creates an audit trail of all balance-affecting transactions
model AccountLedger {
  id                String           @id @default(uuid())
  profileId         String
  bookieId          Int?             // Null for exchange entries or generic
  bookieName        String           // Denormalized for display
  isExchange        Boolean          @default(false)

  entryType         LedgerEntryType
  amount            Decimal          @db.Decimal(10, 2) // Always positive
  direction         String           // 'in' or 'out' relative to bookie balance
  runningBalance    Decimal          @db.Decimal(10, 2) // Balance after this entry

  date              DateTime
  description       String?
  notes             String?          // User notes for adjustments

  // Linking to source data
  bankTransactionId String?          // If from Basiq bank transaction
  trackerEntryId    String?          // If from racing tracker entry
  layManagerEntryId String?          // If from lay manager entry
  bonusCreditId     String?          // If bonus-related

  // Reconciliation
  isReconciled      Boolean          @default(false)
  reconciledAt      DateTime?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  profile           Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bookie            Bookie?          @relation(fields: [bookieId], references: [id])

  @@index([profileId, bookieName])
  @@index([profileId, date])
  @@index([bankTransactionId])
  @@index([trackerEntryId])
  @@index([layManagerEntryId])
  @@index([entryType])
}

/// Account Balance - Current balance per bookie/exchange
/// Stores the computed balance for quick access
model AccountBalance {
  id                String           @id @default(uuid())
  profileId         String
  bookieId          Int?
  bookieName        String
  isExchange        Boolean          @default(false)

  currentBalance    Decimal          @default(0) @db.Decimal(10, 2)
  totalPL           Decimal          @default(0) @db.Decimal(10, 2) // Sum of BET_WIN + BET_LOSS only
  lastUpdated       DateTime         @default(now())

  // Manual override
  isOverridden      Boolean          @default(false)
  overrideValue     Decimal?         @db.Decimal(10, 2)
  overrideReason    String?
  overrideAt        DateTime?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  profile           Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bookie            Bookie?          @relation(fields: [bookieId], references: [id])

  @@unique([profileId, bookieName])
  @@index([profileId])
}
